    "text.8fb81325": null,
    "text.8fcfaa94": null,
    "text.9027c3f8": "Meng · Youthful Inexperience",
    "text.905e7c83": null,
    "text.906fbc93": null,
    "text.90b9e3c4": "Toss three coins six times to receive a hexagram. There is no single right way: start right away with the default settings, or make the method your own.",
    "text.90e8e846": null,
    "text.90fd727d": null,
    "text.9163204b": null,
    "text.917955f5": null,
    "text.91a5391f": null,
    "text.91e5e996": "iYeok is a place to record your life and choices through the I Ching, look back on them, and talk with one another.",
