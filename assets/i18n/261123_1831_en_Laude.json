    "text.8d6e11cf": null,
    "text.8d6e37fc": null,
    "text.8d7f741a": "A hexagram has six lines. The bottom one is line 1 and the top one is line 6. Whatever order you fill them in, the hexagram is read the same way.",
    "text.8e028e7a": null,
    "text.8e6859fc": null,
