    "text.c0907bd0": null,
    "text.c0bc02c0": "Start now",
    "text.c0e030f6": null,
    "text.c165cda4": "100 won",
    "text.c174f8ea": "The side with the number counts as yang.",
    "text.c17b4959": null,
    "text.c1ebccf4": null,
    "text.c32be165": "This is not the only interpretation in the traditional literature; it is a perspective that iYeok proposes.",
